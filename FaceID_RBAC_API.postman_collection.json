{
  "info": {
    "_postman_id": "faceid-rbac-api",
    "name": "FaceID Campus Backend - RBAC API Tests",
    "description": "Comprehensive API tests for role-based access control (RBAC) in FaceID Campus Backend. Tests demonstrate proper role separation between UPLOADER and ADMIN roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. AUTHENTICATION",
      "description": "Login endpoints - public access",
      "item": [
        {
          "name": "Login as UPLOADER (Security Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains token', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.expect(jsonData.role).to.equal('UPLOADER');",
                  "    pm.collectionVariables.set('uploader_token', jsonData.token);",
                  "    pm.collectionVariables.set('uploader_id', jsonData.userId);",
                  "});",
                  "",
                  "pm.test('Token includes UPLOADER role', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.role).to.equal('UPLOADER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"uploader_staff\",\n  \"password\": \"SecurePassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login with UPLOADER role credentials. UPLOADER can only upload incidents, cannot view or manage."
          },
          "response": []
        },
        {
          "name": "Login as ADMIN (School Authority)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains token and ADMIN role', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.expect(jsonData.role).to.equal('ADMIN');",
                  "    pm.collectionVariables.set('admin_token', jsonData.token);",
                  "    pm.collectionVariables.set('admin_id', jsonData.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_authority\",\n  \"password\": \"AdminPassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login with ADMIN role credentials. ADMIN has full access: can review incidents, manage students, and manage users."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. ROLE SEPARATION TESTS",
      "description": "Tests demonstrating role-based access control enforcement",
      "item": [
        {
          "name": "❌ UPLOADER tries GET /incidents (should 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function() {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Response indicates access denied', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.equal('Access Denied');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{uploader_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/incidents",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "incidents"
              ]
            },
            "description": "UPLOADER should NOT be able to view incidents list. Only ADMIN can access GET /incidents."
          },
          "response": []
        },
        {
          "name": "❌ UPLOADER tries POST /students (should 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function() {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Response error is Access Denied', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.equal('Access Denied');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{uploader_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/students",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "students"
              ]
            },
            "description": "UPLOADER cannot enroll students. Only ADMIN can manage students."
          },
          "response": []
        },
        {
          "name": "❌ ADMIN tries POST /incidents/upload (should 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function() {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Response error is Access Denied', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.equal('Access Denied');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/incidents/upload",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "incidents",
                "upload"
              ]
            },
            "description": "ADMIN cannot upload incidents. Only UPLOADER role can submit footage. This enforces separation of concerns."
          },
          "response": []
        }
      ]
    },
